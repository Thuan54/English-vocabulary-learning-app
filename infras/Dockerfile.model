# Use slim Python image (already small, but we will keep it clean)
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# 🛡️ Prevent Hugging Face from caching models inside the Docker image during build
ENV HF_HOME=/tmp/huggingface 
ENV TRANSFORMERS_CACHE=/tmp/huggingface

WORKDIR /app

# Install ONLY essential build tools, then immediately clean up apt cache in the SAME layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first to leverage Docker cache
COPY requirements.txt .

# Install dependencies with --no-cache-dir to prevent pip from storing downloaded wheels
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 🚀 CRITICAL OPTIMIZATION: If you are running on CPU only, replace the massive CUDA PyTorch 
# with the lightweight CPU-only version. This alone saves ~1.5GB.
# (If you actually have a GPU in production, delete these two lines)
RUN pip uninstall -y torch torchvision torchaudio && \
    pip install --no-cache-dir torch torchvision torchaudio --extra-index-url https://download.pytorch.org/whl/cpu

# Copy application code 
# (Ensure ml_server/.dockerignore excludes __pycache__, venv, .git, and any local .bin/.safetensors model files)
COPY . .

# 🧹 Final cleanup: Remove any accidental cache directories created during the build
RUN rm -rf /root/.cache /tmp/*

EXPOSE 8000

CMD ["uvicorn", "routers.main:app", "--host", "0.0.0.0", "--port", "8000"]