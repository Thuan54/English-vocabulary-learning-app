{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "types": ["node", "jest"],
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules","src/__tests__", "src/test"]
}